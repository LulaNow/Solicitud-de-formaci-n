# ==========================================
# NADRO Enterprise Portal - SSO Ready Template
# ==========================================
#
# INSTRUCCIONES:
# 1. Copiar este archivo como .env: cp .env.example .env
# 2. Configurar DATABASE_URL con tu base de datos PostgreSQL
# 3. Configurar las variables SSO con los datos del AppStore
# 4. Ejecutar: npm run db:generate && npm run db:push && npm run db:seed
# 5. Ejecutar: npm run dev
#

# ==========================================
# DATABASE - Tu base de datos PostgreSQL
# ==========================================
# Cambia esta URL por la de TU base de datos local o en la nube
DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_base_datos"

# ==========================================
# AUTH.JS - Secreto para firmar sesiones JWT
# ==========================================
# Genera uno nuevo con: openssl rand -base64 32
AUTH_SECRET="CAMBIA_ESTO_genera_con_openssl_rand_base64_32"
AUTH_TRUST_HOST=true

# ==========================================
# SSO OAuth 2.0 - Configuración (OBLIGATORIO)
# ==========================================
# Estos datos te los proporciona el administrador del sistema SSO
#
# ENDPOINTS DEL SISTEMA SSO:
# - Authorization: Donde el usuario se autentica
SSO_AUTHORIZE_URL="https://appstore.nadro.dev/api/oauth/authorize"
#
# - Token: Donde intercambiamos el código por un access_token
SSO_TOKEN_URL="https://appstore.nadro.dev/api/oauth/token"
#
# - User Info: Donde obtenemos los datos del usuario autenticado
SSO_USERINFO_URL="https://appstore.nadro.dev/api/oauth/userinfo"
#
# CREDENCIALES DE LA APLICACIÓN:
# Client ID - Identificador único de tu aplicación en el sistema SSO
# Ejemplo: cdb065ea-0b25-458e-9e45-1cd476f93b66
SSO_CLIENT_ID="tu_client_id_aqui"
#
# Client Secret - Clave secreta de tu aplicación (NUNCA la compartas)
# ⚠️ IMPORTANTE: Guárdala en un lugar seguro, no la subas a Git
# Ejemplo: nsk_Yad9e_6SdUEafmWAdDnvpBOH440p8rPDMljS96TbJxw
SSO_CLIENT_SECRET="tu_client_secret_aqui"
#
# NOTA: El callback URL debe estar registrado en el sistema SSO
# Callback URL: http://localhost:3001/api/auth/sso/callback (desarrollo)
# Callback URL: https://tu-dominio.com/api/auth/sso/callback (producción)

# ==========================================
# SECURITY - Claves de cifrado
# ==========================================
ENCRYPTION_KEY="a3f7b2c8d9e1f4a6b8c0d2e4f6a8b0c2d4e6f8a0b2c4d6e8f0a2b4c6d8e0f2"
ENCRYPTION_PEPPER="NaDr0-P3pp3r-S3cur1ty-2026-Ent3rpr1s3"
HMAC_SECRET="NaDr0-HMAC-S1gn4tur3-K3y-2026"

# ==========================================
# n8n Integration - Configuración de Webhooks
# ==========================================
# URL base del webhook de n8n (desarrollo local - Test URL)
# Nota: Usa webhook-test para pruebas, webhook para producción
N8N_WEBHOOK_URL="http://localhost:5678/webhook-test/iniciar-solicitud"

# Token de autenticación para n8n (Header: Beca-Windsurf-Token)
N8N_WEBHOOK_TOKEN="110288210288"

# Configuración para otros ambientes (descomentar cuando sea necesario)
# N8N_WEBHOOK_URL="https://lula.app.n8n.cloud/webhook-test/iniciar-solicitud"
# N8N_WEBHOOK_URL="https://tu-n8n-produccion.com/webhook/iniciar-solicitud"
# N8N_WEBHOOK_TOKEN="tu_token_produccion"

# ==========================================
# APP - Configuración general
# ==========================================
# URL donde corre ESTE portal (usado para redirecciones SSO)
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="Mi Portal"
