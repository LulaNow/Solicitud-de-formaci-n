    {
      "parameters": {
        "channel": "#incidents",
        "text": "🚨 *Nuevo Incidente Reportado*\n\n*Prioridad:* {{$json.data.priority}}\n*Tipo:* {{$json.data.incident_type}}\n*Reportado por:* {{$json.data.reporter_name}} ({{$json.data.department}})\n*Asignado a:* {{$json.assignedTo}}\n*SLA:* {{$json.sla}}\n\n*Descripción:*\n{{$json.data.description}}\n\n<https://portal.empresa.com/incidents/{{$json.registryId}}|Ver Detalles>",
        "otherOptions": {}
      },
      "id": "slack-notify",
      "name": "Notificar en Slack",
